--!strict
--!optimize 2

--[[
	Builds the benchmark place with the tree it was built from written into it.

		lune run bench/build

	A run document used to record no commit, so an archived run could not be attributed to a tree
	and the phase-7/8 conclusions rested on numbers nobody could re-derive (M4-1, bench 위험). The
	commit is stamped at *build* time rather than at archive time, because the place that ran is
	the thing the numbers are about, and the archive step can be days later on a different tree.

	Writes `bench/src/shared/Tree.luau` — ignored by git, read by the client into `results.tree` —
	then runs `rojo build`. A place built with plain `rojo build` carries no `Tree` module and the
	document says `unknown`, which is honest and visible.
]]

local fs = require("@lune/fs")
local process = require("@lune/process")

local function git(...: string): string
	local result = process.exec("git", { ... })
	assert(result.ok, `git {table.concat({ ... }, " ")} failed: {result.stderr}`)
	return (string.gsub(result.stdout, "%s+$", ""))
end

local commit = git("rev-parse", "--short=10", "HEAD")
local dirty = git("status", "--porcelain", "--", "src", "bench", "tests") ~= ""
local builtAt = os.date("!%Y-%m-%dT%H:%M:%SZ")

fs.writeFile(
	"bench/src/shared/Tree.luau",
	"--!strict\n"
		.. "--[[ Generated by bench/build.luau; not tracked. Which tree this place was built from. ]]\n"
		.. `return table.freeze(\{ commit = "{commit}", dirty = {tostring(dirty)}, builtAt = "{builtAt}" \})\n`
)

local output = process.args[1] or "bench/Benchmark.rbxl"
local built = process.exec("rojo", { "build", "bench/default.project.json", "-o", output })
assert(built.ok, `rojo build failed: {built.stderr}`)

print(`built {output} from {commit}{if dirty then " (dirty)" else ""} at {builtAt}`)
